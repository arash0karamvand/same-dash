# کپی: cp .env.docker.example .env
# اجرا: docker compose up -d --build
# سایت: http://localhost:8080
# ورود پیش‌فرض (setup_mysql): admin / admin1234

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-generate-a-long-random-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

FRONTEND_ORIGIN=http://localhost:8080

# برای HTTP محلی — کوکی session بدون HTTPS
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

DB_ENGINE=mysql
DB_NAME=same_dashboard
DB_USER=dashboard
DB_PASSWORD=dashboard_pass
DB_HOST=db
DB_PORT=3306

# فقط برای سرویس db در docker-compose
DB_ROOT_PASSWORD=root_pass_change_me

HTTP_PORT=8080
RUN_SEED=1

SMS_GATEWAY=logic.sms.MockSmsGateway
SMS_API_KEY=
SMS_SENDER=
