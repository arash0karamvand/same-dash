# کپی کنید به .env در همین پوشه و مقادیر را تنظیم کنید.
# cp .env.example .env   (یا در ویندوز: copy .env.example .env)

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=mysql
DB_NAME=same_dashboard
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# آدرس فرانت در توسعه (CORS)
# FRONTEND_ORIGIN=http://localhost:5173

# پیامک؛ پیش‌فرض شبیه‌سازی است
# SMS_GATEWAY=logic.sms.MockSmsGateway
# SMS_API_KEY=
# SMS_SENDER=

# در تولید با HTTPS مقدار true بگذارید
# SESSION_COOKIE_SECURE=false
# CSRF_COOKIE_SECURE=false

# اتصال Odoo (اختیاری)
# ODOO_URL=https://your-odoo-server.com
# ODOO_DB=your_database
# ODOO_USER=admin
# ODOO_PASSWORD=
# ODOO_JOURNAL_ID=1

# اتصال ERPNext (اختیاری)
# ERPNEXT_URL=https://your-erpnext-server.com
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
# ERPNEXT_COMPANY=شرکت نمونه
# ERPNEXT_COMPANY_ABBR=CO
