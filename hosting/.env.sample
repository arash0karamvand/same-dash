# نمونه فایل متغیرهای محیطی برای اجرای پروژه روی سرور/هاست.
# این فایل را به صورت .env کپی کرده و مقادیر واقعی را جایگزین کنید.
# مقادیر حساس (SECRET_KEY و ...) نباید در version control قرار گیرند.

# کلید امنیتی Django (حتماً در تولید مقدار تصادفی و محرمانه بگذارید)
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# حالت دیباگ: در تولید حتماً False باشد
DJANGO_DEBUG=False

# دامنه‌های مجاز، جداشده با کاما
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# آدرس فرانت‌اند (برای CORS در صورت جدا بودن دامنه)
FRONTEND_ORIGIN=https://example.com

# درگاه پیامک: مسیر کلاس سازگار با logic.sms.BaseSmsGateway
# پیش‌فرض شبیه‌سازی (بدون ارسال واقعی): logic.sms.MockSmsGateway
# برای درگاه واقعی: logic.sms.GenericHttpSmsGateway (پس از تکمیل پیاده‌سازی)
SMS_GATEWAY=logic.sms.MockSmsGateway

# اطلاعات درگاه واقعی پیامک (در صورت اتصال سرویس واقعی)
SMS_API_KEY=
SMS_SENDER=

# دیتابیس — پیش‌فرض MySQL است (فایل .env را در ریشه پروژه کپی کنید)
DB_ENGINE=mysql
DB_NAME=same_dashboard
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# برای برگشت به SQLite در توسعه:
# DB_ENGINE=sqlite
